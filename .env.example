# Copy to .env and replace the password hash. Never commit .env.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=pbkdf2_sha256$600000$replace_salt$replace_digest
# Set true behind production HTTPS.
ADMIN_COOKIE_SECURE=false
# Set false only when intentionally running the administrator without login.
ADMIN_LOGIN_REQUIRED=true
# Optional point-in-time fact overrides:
# MARKET_TVL_DATA=/absolute/path/to/dex_pool_tvl_latest.csv
# MARKET_CEX_DEPTH_DATA=/absolute/path/to/cex_depth_latest.csv

# Copy to .env for local development. Never commit .env.
# Fail-closed default: admin.html and every /api/admin/* route return 404.
ADMIN_ENABLED=false
ADMIN_LOGIN_REQUIRED=true
ADMIN_ALLOW_OPEN_LOCAL=false

# Login-mode values are used only when ADMIN_ENABLED=true.
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
# Keep false for loopback HTTP development. Production HTTPS must use true.
ADMIN_COOKIE_SECURE=false

# Review intake is durable even when notification email is disabled.
# Blank DB path uses <MARKET_DATA_DIR>/admin/token_reviews.sqlite3.
TOKEN_REVIEW_DB_PATH=
TOKEN_REVIEW_EMAIL_ENABLED=false
# Fill private operator configuration only; never commit a real mailbox or secret.
TOKEN_REVIEWER_EMAIL=
TOKEN_REVIEW_BASE_URL=
TOKEN_REVIEW_SMTP_HOST=
TOKEN_REVIEW_SMTP_PORT=
# Required for SMTP credentials; validates the relay certificate and hostname.
TOKEN_REVIEW_SMTP_STARTTLS=true
TOKEN_REVIEW_SMTP_FROM=
TOKEN_REVIEW_SMTP_USERNAME=
TOKEN_REVIEW_SMTP_PASSWORD=

# Isolated local open mode requires all three flags below and a loopback bind:
# ADMIN_ENABLED=true
# ADMIN_LOGIN_REQUIRED=false
# ADMIN_ALLOW_OPEN_LOCAL=true
# It is rejected on 0.0.0.0, ::, public addresses, and non-local hostnames.

# Optional point-in-time fact overrides:
# MARKET_TVL_DATA=/absolute/path/to/dex_pool_tvl_latest.csv
# MARKET_CEX_DEPTH_DATA=/absolute/path/to/cex_depth_latest.csv
# MARKET_DEX_DEPTH_DATA=/absolute/path/to/dex_depth_latest.csv
# MARKET_CEX_EXECUTION_COST_DATA=/absolute/path/to/cex_execution_cost_latest.csv
# MARKET_DEX_EXECUTION_COST_DATA=/absolute/path/to/dex_execution_cost_latest.csv
# Optional JSON-RPC overrides. Defaults are documented in the DEX depth contract.
# DEX_DEPTH_RPC_ETH=https://your-ethereum-rpc.example
# DEX_DEPTH_RPC_ARBITRUM=https://your-arbitrum-rpc.example
# DEX_DEPTH_RPC_OPTIMISM=https://your-optimism-rpc.example
# DEX_DEPTH_RPC_BASE=https://your-base-rpc.example
# DEX_DEPTH_RPC_BSC=https://your-bsc-rpc.example
# DEX_DEPTH_RPC_ZKSYNC=https://your-zksync-rpc.example

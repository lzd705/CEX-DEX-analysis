limit_req_zone $binary_remote_addr zone=cex_dex_public:10m rate=20r/s;

server {
    listen 80;
    listen [::]:80;
    server_name @DOMAIN@;
    return 301 https://@DOMAIN@$request_uri;
}

server {
    listen 443 ssl http2;
    listen [::]:443 ssl http2;
    server_name @DOMAIN@;

    ssl_certificate /etc/letsencrypt/live/@DOMAIN@/fullchain.pem;
    ssl_certificate_key /etc/letsencrypt/live/@DOMAIN@/privkey.pem;
    ssl_protocols TLSv1.2 TLSv1.3;
    add_header Strict-Transport-Security "max-age=31536000; includeSubDomains" always;

    access_log /var/log/nginx/cex-dex-access.log;
    error_log /var/log/nginx/cex-dex-error.log warn;
    client_max_body_size 32k;

    # Public deployments never expose the write-capable administrator surface.
    location = /admin { return 404; }
    location = /admin.html { return 404; }
    location = /admin.js { return 404; }
    location = /api/admin { return 404; }
    location ^~ /api/admin/ { return 404; }

    location / {
        limit_req zone=cex_dex_public burst=40 nodelay;
        proxy_pass http://127.0.0.1:8765;
        proxy_http_version 1.1;
        proxy_set_header Host $host;
        proxy_set_header X-Forwarded-Proto https;
        proxy_set_header X-Forwarded-For $proxy_add_x_forwarded_for;
        # Overwrite, rather than append, the address consumed by the
        # loopback-only application's public-action rate limiter. The matching
        # application environment must explicitly set
        # TRUST_LOOPBACK_PROXY_CLIENT_IP=true.
        proxy_set_header X-Real-IP $remote_addr;
        proxy_connect_timeout 3s;
        # Token preview performs two bounded upstream source reads (30s each).
        # Keep the proxy response window above that server-side upper bound so
        # a mutation response is not abandoned while the backend continues.
        proxy_read_timeout 75s;
    }
}

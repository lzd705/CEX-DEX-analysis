# Render with deploy/render_runtime_templates.py, then install the generated
# dashboard.env as /etc/cex-dex/dashboard.env with mode 0600.
# The application is always bound to 127.0.0.1; expose it only through HTTPS.
MARKET_DATA_DIR=@MARKET_DATA_DIR@
# Daily collection atomically replaces this source-backed current-catalog
# manifest. The dashboard must read the runtime file, not the tracked seed.
MARKET_CEX_INSTRUMENT_LIFECYCLE=@MARKET_DATA_DIR@/cex_instrument_lifecycle.json
# Optional explicit point-in-time overrides when files are outside that directory:
# MARKET_CEX_EXECUTION_COST_DATA=/absolute/path/to/cex_execution_cost_latest.csv
# MARKET_DEX_EXECUTION_COST_DATA=/absolute/path/to/dex_execution_cost_latest.csv

# Optional route-research CEX fee evidence. The private CSV contains no API
# credentials, must be outside the repository/web root, owned by the service
# user, and mode 0600. Keep this blank when no validated account fee profile is
# installed; missing authentication then stays explicitly unavailable.
MARKET_CEX_PRIVATE_FEE_PROFILE=
# Public schedules are opt-in research bounds and can never enter strict
# executable ranking. The tracked file is intentionally header-only until a
# reviewed, current, non-account-specific bound satisfies the documented gate.
MARKET_CEX_PUBLIC_FEE_SCHEDULE=@PROJECT_ROOT@/config/cex_public_fee_schedules.csv

# Optional strict route-inventory evidence. Use one absolute path outside the
# repository and web root. Every parent component must be a real directory,
# never a symlink; the CSV must be a single-link regular file owned by the
# service user and mode 0600. Public route output retains only its opaque
# profile hash, exact route/quantity request binding, evidence window, and
# proved Token capacity—never balances, accounts, wallets, keys, or this local
# path. Per-record source SHA-256 values are lineage checks, not authentication;
# trust comes from the owner-only profile boundary. Leave blank when current
# private evidence is unavailable.
MARKET_ROUTE_PRIVATE_INVENTORY_PROFILE=

# Fail-closed default: admin.html and every /api/admin/* route return 404.
ADMIN_ENABLED=false
ADMIN_LOGIN_REQUIRED=true
ADMIN_ALLOW_OPEN_LOCAL=false

# Set all four values below only after HTTPS and proxy access controls exist.
ADMIN_COOKIE_SECURE=true
ADMIN_USERNAME=admin
ADMIN_PASSWORD_HASH=
ADMIN_JOB_DIR=@ADMIN_JOB_DIR@

# Narrow public self-service actions are independent from /api/admin/* and
# remain fail-closed unless each capability is explicitly approved.
# Add Token is a two-step flow: resolve a supported chain + contract address,
# then confirm the returned Token symbol. Collection always uses the
# server-fixed 30-day history budget. Quality retry accepts only an exact
# Token/date/market-source window from the current daily quality report.
# Accepted public mutations can be polled only by their 128-bit job id at
# GET /api/actions/jobs/<job_id>; no job list or administrator data is public.
PUBLIC_ADD_TOKEN_ENABLED=false
PUBLIC_QUALITY_RETRY_ENABLED=false
# Allows a user to retry only a cataloged TVL/depth N/A whose quality fact is
# explicitly marked retryable by the server. Requests remain rate- and job-budgeted.
PUBLIC_FACT_REFRESH_ENABLED=false

# Keep false for direct connections and raw TCP/socket proxies, because they
# do not overwrite attacker-supplied HTTP headers. Set true only when every
# application connection comes from a controlled loopback reverse proxy that
# overwrites X-Real-IP (as the bundled Nginx template does).
TRUST_LOOPBACK_PROXY_CLIENT_IP=false

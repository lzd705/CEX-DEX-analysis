[Unit]
Description=CEX/DEX fact-only Market Monitor (unprivileged fallback)
StartLimitIntervalSec=120
StartLimitBurst=5

[Service]
Type=simple
WorkingDirectory=@PROJECT_ROOT@
Environment=PYTHONUNBUFFERED=1
Environment=PYTHONDONTWRITEBYTECODE=1
Environment=ADMIN_ENABLED=false
Environment=MARKET_DATA_DIR=@MARKET_DATA_DIR@
Environment=MARKET_CEX_INSTRUMENT_LIFECYCLE=@MARKET_DATA_DIR@/cex_instrument_lifecycle.json
EnvironmentFile=-%h/.config/cex-dex/dashboard.env
ExecStart=/usr/bin/python3 dashboard/server.py --host @BIND_HOST@ --port 8765
Restart=on-failure
RestartSec=5s
TimeoutStopSec=20s
KillSignal=SIGTERM
StandardOutput=journal
StandardError=journal
SyslogIdentifier=cex-dex-dashboard
NoNewPrivileges=true
PrivateTmp=true
LockPersonality=true
RestrictRealtime=true
RestrictSUIDSGID=true
RestrictAddressFamilies=AF_UNIX AF_INET AF_INET6
SystemCallArchitectures=native
UMask=0077

[Install]
WantedBy=default.target

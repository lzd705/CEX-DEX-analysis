[Unit]
Description=CEX/DEX hourly CEX order-book and DEX pool-state depth collection
After=network-online.target
Wants=network-online.target

[Service]
Type=oneshot
WorkingDirectory=@PROJECT_ROOT@
Environment=PYTHONUNBUFFERED=1
ExecStart=/usr/bin/python3 scripts/run_collection_cycle.py --profile depth --publish-local
TimeoutStartSec=30min
Nice=10
